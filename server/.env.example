# ─────────────────────────────────────────────
#  The Orvion RAG Chatbot — Server Environment
# ─────────────────────────────────────────────

# Ollama must be running locally.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_TIMEOUT_MS=180000
OLLAMA_MAX_TOKENS=512

# Use keyword retrieval by default so the chatbot does not depend on Gemini.
# Set to semantic only if you have regenerated the vector store with a working embedding provider.
RAG_RETRIEVAL_MODE=keyword
RAG_TOP_K=3

# Server port
GEMINI_API_KEY=your_google_ai_studio_key_here
PORT=3001

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173

# Supabase Storage (server-only; do not use a VITE_ prefix or expose the secret key)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_BLOG_BUCKET=blog-images

# Environment
NODE_ENV=development
